<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <AssemblyName>WU-BT10-Windows-Fix</AssemblyName>
    <RootNamespace>WUBT10Fix</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.1.0</Version>
    <Authors>WU-BT10 Windows Fix contributors</Authors>
    <Company>WU-BT10 Windows Fix contributors</Company>
    <Product>WU-BT10 Windows Fix</Product>
    <Description>Repairs WU-BT10 Bluetooth audio and bridges low-latency BLE MIDI on Windows.</Description>
    <Copyright>Copyright © 2026 WU-BT10 Windows Fix contributors</Copyright>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <RepositoryUrl Condition="'$(RepositoryUrl)' == ''">https://github.com/OWNER/WU-BT10-Windows-Audio-Fix</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\app-icon.png" LogicalName="WUBT10Fix.app-icon.png" />
  </ItemGroup>
</Project>
